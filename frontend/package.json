{
  "name": "pin-note",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "cd .. && frontend/node_modules/.bin/prettier --write . --ignore-unknown",
    "format:check": "cd .. && frontend/node_modules/.bin/prettier --check . --ignore-unknown"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.7",
    "prettier-plugin-java": "^2.10.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.0.1"
  }
}
